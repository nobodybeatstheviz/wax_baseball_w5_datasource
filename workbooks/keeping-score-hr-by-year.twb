<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.1.0 (20261.26.0401.1148)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences />
  <datasources>
    <datasource caption='Keeping Score - Plays' inline='true' name='KeepingScore-Plays' version='18.1'>
      <repository-location id='KeepingScore-Plays' path='/t/nobodybeatstheviz/datasources' revision='1.0' site='nobodybeatstheviz' />
      <connection channel='https' class='sqlproxy' dbname='KeepingScore-Plays' directory='/dataserver' port='443' server='10ax.online.tableau.com' username=''>
        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <column datatype='date' name='[game_date]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[event_code]' role='measure' type='quantitative' />
      <column caption='Home Runs' datatype='integer' name='[Calculation_HR]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([event_code] = 23, 1, 0)' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='HR by Year'>
      <table>
        <view>
          <datasources>
            <datasource caption='Keeping Score - Plays' name='KeepingScore-Plays' />
          </datasources>
          <datasource-dependencies datasource='KeepingScore-Plays'>
            <column datatype='date' name='[game_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[event_code]' role='measure' type='quantitative' />
            <column caption='Home Runs' datatype='integer' name='[Calculation_HR]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([event_code] = 23, 1, 0)' />
            </column>
            <column-instance column='[Calculation_HR]' derivation='Sum' name='[sum:Calculation_HR:qk]' pivot='key' type='quantitative' />
            <column-instance column='[game_date]' derivation='Year' name='[yr:game_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[KeepingScore-Plays].[sum:Calculation_HR:qk]</rows>
        <cols>[KeepingScore-Plays].[yr:game_date:ok]</cols>
      </table>
      <simple-id uuid='{43A6D215-B83F-4A49-90E2-95BACF9A393B}' />
    </worksheet>
  </worksheets>
  <windows>
    <window class='worksheet' maximized='true' name='HR by Year'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
          <strip size='31'>
            <card type='title' />
          </strip>
        </edge>
      </cards>
    </window>
  </windows>
</workbook>
